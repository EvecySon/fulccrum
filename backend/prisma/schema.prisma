// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  customer
  business_owner
  driver
  admin
}

enum UserStatus {
  active
  inactive
  suspended
  deleted
}

enum OrderStatus {
  pending
  scheduled
  accepted
  rejected
  preparing
  ready
  ready_for_pickup
  picked_up
  in_transit
  delivered
  cancelled
  refunded
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
  partially_refunded
}

enum NotificationType {
  order_update
  delivery_update
  payment_update
  promotion
  system_alert
  support_message
  review_request
  order
  promo
  earnings
  system
  quest
  safety
  document
  transactional
  engagement
  promotional
  reminder
  alert
  informational
}

enum WithdrawalStatus {
  pending
  confirmed
  processing
  completed
  failed
  cancelled
  expired
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  email         String     @unique @db.VarChar(255)
  phone         String?    @unique @db.VarChar(20)
  passwordHash  String     @map("password_hash") @db.VarChar(255)
  firstName     String     @map("first_name") @db.VarChar(100)
  lastName      String     @map("last_name") @db.VarChar(100)
  avatarUrl     String?    @map("avatar_url")
  dateOfBirth   DateTime?  @map("date_of_birth") @db.Date
  role          UserRole   @default(customer)
  status        UserStatus @default(active)
  emailVerified Boolean    @default(false) @map("email_verified")
  phoneVerified Boolean    @default(false) @map("phone_verified")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  lastLogin           DateTime? @map("last_login")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  accountLockedUntil  DateTime? @map("account_locked_until")

  customerProfile CustomerProfile?
  driverProfile   DriverProfile?
  businessProfile BusinessProfile?
  addresses       Address[]

  ordersAsCustomer Order[] @relation("customer_orders")
  ordersAsDriver   Order[] @relation("driver_orders")

  refreshTokens            RefreshToken[]
  notifications            Notification[]
  wallet                   DigitalWallet?
  deviceTokens             DeviceToken[]
  withdrawalRequests       WithdrawalRequest[]
  mediaFiles               MediaFile[]
  driverLocations          DriverLocation[]
  customerReviews          Review[]                  @relation("customer_reviews")
  driverReviews            Review[]                  @relation("driver_reviews")
  supportTickets           SupportTicket[]           @relation("user_tickets")
  assignedTickets          SupportTicket[]           @relation("assigned_tickets")
  supportMessages          SupportMessage[]
  favorites                Favorite[]
  passwordResets           PasswordReset[]
  bankAccounts             BankAccount[]
  savedCards               SavedCard[]
  crmCustomerNotes         CrmCustomerNote[]         @relation("crm_customer_notes")
  merchantCustomerProfiles MerchantCustomerProfile[] @relation("merchant_customer_profiles")
  hostedGroupOrders        GroupOrder[]              @relation("group_order_host")
  groupOrderMemberships    GroupOrderMember[]        @relation("group_order_members")
  customerLoyalty          CustomerLoyalty?
  adminUser                AdminUser?                @relation("admin_user_profile")
  documents                Document[]
  verifiedDocuments        Document[]                @relation("DocumentVerifier")

  courierScheduleSlots    CourierScheduleSlot[]     @relation("CourierScheduleSlots")
  courierQuestProgress    CourierQuestProgress[]    @relation("CourierQuestProgress")
  courierPreferences      CourierPreferences?       @relation("CourierPreferences")
  referralsGiven          Referral[]                @relation("Referrer")
  referralsReceived       Referral[]                @relation("Referred")
  insuranceClaims         InsuranceClaim[]          @relation("InsuranceClaims")
  maintenanceLogs         MaintenanceLog[]          @relation("MaintenanceLogs")
  courierTrainingProgress CourierTrainingProgress[] @relation("CourierTrainingProgress")
  verificationAttempts    VerificationAttempt[]     @relation("CourierVerificationAttempts")
  scheduleNoShows         ScheduleNoShow[]          @relation("ScheduleNoShows")
  auditLogs               AuditLog[]                @relation("UserAuditLogs")
  notificationTemplates   NotificationTemplate[]    @relation("NotificationTemplateCreator")
  notificationLogs        NotificationLog[]         @relation("UserNotificationLogs")

  dietaryPreferences String[] @default([]) @map("dietary_preferences")
  allergies          String[] @default([]) @map("allergies")
  customAllergies    String?  @map("custom_allergies") @db.VarChar(500)

  @@map("users")
}

model CustomerProfile {
  userId           String  @id @map("user_id") @db.Uuid
  defaultAddressId String? @map("default_address_id") @db.Uuid
  preferences      Json    @default("{}")
  loyaltyPoints    Int     @default(0) @map("loyalty_points")
  loyaltyTier      String  @default("bronze") @map("loyalty_tier") @db.VarChar(20)
  totalOrders      Int     @default(0) @map("total_orders")
  totalSpent       Decimal @default(0.0) @map("total_spent") @db.Decimal(10, 2)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

model DriverProfile {
  userId                String    @id @map("user_id") @db.Uuid
  vehicleType           String    @map("vehicle_type") @db.VarChar(50)
  vehicleMake           String?   @map("vehicle_make") @db.VarChar(50)
  vehicleModel          String?   @map("vehicle_model") @db.VarChar(50)
  vehicleYear           Int?      @map("vehicle_year")
  vehicleColor          String?   @map("vehicle_color") @db.VarChar(30)
  licensePlate          String?   @map("license_plate") @db.VarChar(20)
  driverLicenseNumber   String?   @map("driver_license_number") @db.VarChar(50)
  backgroundCheckStatus String    @default("pending") @map("background_check_status") @db.VarChar(20)
  backgroundCheckDate   DateTime? @map("background_check_date")
  insuranceExpiration   DateTime? @map("insurance_expiration") @db.Date
  rating                Decimal   @default(5.0) @db.Decimal(3, 2)
  totalDeliveries       Int       @default(0) @map("total_deliveries")
  onlineStatus          Boolean   @default(false) @map("online_status")
  lastLocationUpdate    DateTime? @map("last_location_update")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("driver_profiles")
}

model BusinessProfile {
  userId                 String    @id @map("user_id") @db.Uuid
  businessName           String    @map("business_name") @db.VarChar(255)
  businessType           String    @map("business_type") @db.VarChar(50)
  description            String?   @db.Text
  address                String?   @db.VarChar(255)
  address2               String?   @db.VarChar(255)
  city                   String?   @db.VarChar(100)
  state                  String?   @db.VarChar(100)
  lga                    String?   @db.VarChar(100)
  logoUrl                String?   @map("logo_url") @db.Text
  coverImageUrl          String?   @map("cover_image_url") @db.Text
  website                String?   @db.VarChar(255)
  phone                  String?   @db.VarChar(20)
  email                  String?   @db.VarChar(255)
  taxId                  String?   @map("tax_id") @db.VarChar(50)
  businessLicense        String?   @map("business_license") @db.VarChar(100)
  verificationStatus     String    @default("pending") @map("verification_status") @db.VarChar(20)
  verificationDate       DateTime? @map("verification_date")
  rating                 Decimal   @default(5.00) @db.Decimal(3, 2)
  averagePreparationTime Int       @default(15) @map("average_preparation_time")
  maxConcurrentOrders    Int       @default(10) @map("max_concurrent_orders")
  deliveryRadius         Decimal   @default(5.00) @map("delivery_radius") @db.Decimal(5, 2)
  autoAcceptOrders       Boolean   @default(false) @map("auto_accept_orders")
  deliveryFee            Decimal   @default(0.00) @map("delivery_fee") @db.Decimal(5, 2)
  minimumOrderAmount     Decimal   @default(0.00) @map("minimum_order_amount") @db.Decimal(8, 2)
  isOpen                 Boolean   @default(true) @map("is_open")
  priceRange             String?   @map("price_range") @db.VarChar(10)
  estimatedDeliveryTime  String?   @map("estimated_delivery_time") @db.VarChar(20)
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  user                User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses           Address[]
  orders              Order[]
  menuCategories      MenuCategory[]
  businessHours       BusinessHours[]
  reviews             Review[]
  favorites           Favorite[]
  crmCampaigns        CrmCampaign[]
  crmCustomerNotes    CrmCustomerNote[]
  flashSales          FlashSale[]
  channels            MerchantChannel[]
  subscriptions       MerchantSubscription[]
  pricingRules        PricingRule[]
  loyaltyProgram      LoyaltyProgram?
  kitchenOperations   KitchenOperation[]
  aiInsights          MerchantAiInsight[]
  customerProfiles    MerchantCustomerProfile[]
  marketplaceListings MarketplaceListing[]
  groupOrders         GroupOrder[]              @relation("group_order_business")
  merchantCommissions MerchantCommission[]
  merchantCompliance  MerchantCompliance?

  @@map("business_profiles")
}

model Address {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  businessId    String?  @map("business_id") @db.Uuid
  label         String?  @db.VarChar(50)
  streetAddress String   @map("street_address") @db.VarChar(255)
  apartment     String?  @db.VarChar(50)
  city          String   @db.VarChar(100)
  state         String   @db.VarChar(100)
  postalCode    String   @map("postal_code") @db.VarChar(20)
  country       String   @db.VarChar(100)
  latitude      Decimal? @db.Decimal(10, 8)
  longitude     Decimal? @db.Decimal(11, 8)
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user     User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  business BusinessProfile? @relation(fields: [businessId], references: [userId], onDelete: Cascade)
  orders   Order[]          @relation("order_delivery_address")

  @@map("addresses")
}

model Order {
  id          String      @id @default(uuid()) @db.Uuid
  orderNumber String      @unique @map("order_number") @db.VarChar(20)
  customerId  String      @map("customer_id") @db.Uuid
  businessId  String      @map("business_id") @db.Uuid
  driverId    String?     @map("driver_id") @db.Uuid
  status      OrderStatus @default(pending)

  subtotal       Decimal @db.Decimal(10, 2)
  deliveryFee    Decimal @map("delivery_fee") @db.Decimal(5, 2)
  serviceFee     Decimal @map("service_fee") @db.Decimal(5, 2)
  taxAmount      Decimal @map("tax_amount") @db.Decimal(5, 2)
  tipAmount      Decimal @default(0.0) @map("tip_amount") @db.Decimal(5, 2)
  discountAmount Decimal @default(0.0) @map("discount_amount") @db.Decimal(5, 2)
  totalAmount    Decimal @map("total_amount") @db.Decimal(10, 2)

  placedAt              DateTime  @default(now()) @map("placed_at")
  acceptedAt            DateTime? @map("accepted_at")
  preparationStartedAt  DateTime? @map("preparation_started_at")
  readyAt               DateTime? @map("ready_at")
  pickedUpAt            DateTime? @map("picked_up_at")
  deliveredAt           DateTime? @map("delivered_at")
  estimatedDeliveryTime DateTime? @map("estimated_delivery_time")

  specialInstructions String?       @map("special_instructions")
  paymentMethod       String?       @map("payment_method") @db.VarChar(50)
  paymentStatus       PaymentStatus @default(pending) @map("payment_status")
  paymentId           String?       @unique @map("payment_id") @db.VarChar(255)
  deliveryAddressId   String?       @map("delivery_address_id") @db.Uuid

  scheduledFor    DateTime? @map("scheduled_for")
  fulfillmentType String    @default("delivery") @map("fulfillment_type") @db.VarChar(20)
  deliveryOption  String?   @map("delivery_option") @db.VarChar(30)
  deliveryNote    String?   @map("delivery_note") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customer        User             @relation("customer_orders", fields: [customerId], references: [id], onDelete: Cascade)
  business        BusinessProfile  @relation(fields: [businessId], references: [userId], onDelete: Cascade)
  driver          User?            @relation("driver_orders", fields: [driverId], references: [id], onDelete: SetNull)
  deliveryAddress Address?         @relation("order_delivery_address", fields: [deliveryAddressId], references: [id], onDelete: SetNull)
  review          Review?
  items           OrderItem[]
  groupOrder      GroupOrder?      @relation("group_order_placed")
  platformRevenue PlatformRevenue?
  refunds         Refund[]
  chargebacks     Chargeback[]
  incidents       Incident[]
  deliveryProofs  DeliveryProof[]

  @@index([customerId])
  @@index([businessId])
  @@index([driverId])
  @@index([status])
  @@index([deliveryAddressId])
  @@map("orders")
}

// Security: Refresh Token for JWT rotation
model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique @db.VarChar(500)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// Digital Wallet for payments and withdrawals
model DigitalWallet {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  balance        Decimal  @default(0) @db.Decimal(10, 2)
  pendingBalance Decimal  @default(0) @map("pending_balance") @db.Decimal(10, 2)
  frozenBalance  Decimal  @default(0) @map("frozen_balance") @db.Decimal(10, 2)
  currency       String   @default("NGN") @db.VarChar(3)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  withdrawalRequests WithdrawalRequest[]

  @@map("digital_wallets")
}

// Withdrawal Request with security features
model WithdrawalRequest {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  walletId          String           @map("wallet_id") @db.Uuid
  amount            Decimal          @db.Decimal(10, 2)
  reference         String           @unique @db.VarChar(100)
  status            WithdrawalStatus @default(pending)
  confirmationCode  String?          @map("confirmation_code") @db.VarChar(6)
  codeExpiresAt     DateTime?        @map("code_expires_at")
  requestedAt       DateTime         @default(now()) @map("requested_at")
  confirmedAt       DateTime?        @map("confirmed_at")
  processedAt       DateTime?        @map("processed_at")
  ipAddress         String?          @map("ip_address") @db.VarChar(45)
  deviceFingerprint String?          @map("device_fingerprint") @db.VarChar(255)
  failedReason      String?          @map("failed_reason")

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet DigitalWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([walletId])
  @@index([status])
  @@map("withdrawal_requests")
}

// Notifications for push, email, SMS
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(255)
  message   String
  data      Json?            @default("{}")
  isRead    Boolean          @default(false) @map("is_read")
  sentAt    DateTime?        @map("sent_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// Device Tokens for push notifications (mobile)
model DeviceToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique @db.VarChar(500)
  platform  String   @db.VarChar(20) // 'ios' | 'android' | 'web'
  deviceId  String?  @map("device_id") @db.VarChar(255)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("device_tokens")
}

// Media Files for uploads (images, documents)
model MediaFile {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  filename     String   @db.VarChar(255)
  originalName String   @map("original_name") @db.VarChar(255)
  mimeType     String   @map("mime_type") @db.VarChar(100)
  size         Int
  url          String   @db.VarChar(500)
  thumbnailUrl String?  @map("thumbnail_url") @db.VarChar(500)
  mediumUrl    String?  @map("medium_url") @db.VarChar(500)
  uploadedAt   DateTime @default(now()) @map("uploaded_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([uploadedAt])
  @@map("media_files")
}

// Driver Location for GPS tracking
model DriverLocation {
  id        String   @id @default(uuid()) @db.Uuid
  driverId  String   @map("driver_id") @db.Uuid
  latitude  Decimal  @db.Decimal(10, 8)
  longitude Decimal  @db.Decimal(11, 8)
  accuracy  Float?
  heading   Float?
  speed     Float?
  timestamp DateTime @default(now())

  driver User @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, timestamp])
  @@index([timestamp])
  @@map("driver_locations")
}

// Menu Management Models

// Menu Categories
model MenuCategory {
  id           String   @id @default(uuid()) @db.Uuid
  businessId   String   @map("business_id") @db.Uuid
  name         String   @db.VarChar(100)
  description  String?  @db.Text
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  business BusinessProfile @relation(fields: [businessId], references: [userId], onDelete: Cascade)
  items    MenuItem[]

  @@index([businessId])
  @@index([businessId, isActive])
  @@map("menu_categories")
}

// Menu Items
model MenuItem {
  id              String   @id @default(uuid()) @db.Uuid
  businessId      String   @map("business_id") @db.Uuid
  categoryId      String   @map("category_id") @db.Uuid
  name            String   @db.VarChar(255)
  description     String?  @db.Text
  price           Decimal  @db.Decimal(10, 2)
  costPrice       Decimal? @map("cost_price") @db.Decimal(10, 2)
  images          Json     @default("[]")
  ingredients     String[] @default([])
  allergens       String[] @default([])
  nutritionalInfo Json?    @map("nutritional_info")
  preparationTime Int      @default(15) @map("preparation_time")
  isAvailable     Boolean  @default(true) @map("is_available")
  isFeatured      Boolean  @default(false) @map("is_featured")
  displayOrder    Int      @default(0) @map("display_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  category   MenuCategory       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  inventory  Inventory?
  modifiers  ItemModifierLink[]
  orderItems OrderItem[]

  @@index([businessId])
  @@index([categoryId])
  @@index([businessId, isAvailable])
  @@index([businessId, isFeatured])
  @@map("menu_items")
}

// Item Modifiers (e.g., Size, Toppings)
model ItemModifier {
  id           String   @id @default(uuid()) @db.Uuid
  businessId   String   @map("business_id") @db.Uuid
  name         String   @db.VarChar(100)
  type         String   @db.VarChar(20) // 'single' or 'multiple'
  isRequired   Boolean  @default(false) @map("is_required")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  options ModifierOption[]
  items   ItemModifierLink[]

  @@index([businessId])
  @@map("item_modifiers")
}

// Modifier Options (e.g., Small, Medium, Large)
model ModifierOption {
  id              String   @id @default(uuid()) @db.Uuid
  modifierId      String   @map("modifier_id") @db.Uuid
  name            String   @db.VarChar(100)
  priceAdjustment Decimal  @default(0) @map("price_adjustment") @db.Decimal(5, 2)
  displayOrder    Int      @default(0) @map("display_order")
  isAvailable     Boolean  @default(true) @map("is_available")
  createdAt       DateTime @default(now()) @map("created_at")

  modifier ItemModifier @relation(fields: [modifierId], references: [id], onDelete: Cascade)

  @@index([modifierId])
  @@map("modifier_options")
}

// Link table for items and modifiers (many-to-many)
model ItemModifierLink {
  id         String   @id @default(uuid()) @db.Uuid
  itemId     String   @map("item_id") @db.Uuid
  modifierId String   @map("modifier_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  item     MenuItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  modifier ItemModifier @relation(fields: [modifierId], references: [id], onDelete: Cascade)

  @@unique([itemId, modifierId])
  @@index([itemId])
  @@index([modifierId])
  @@map("item_modifier_links")
}

// Business Hours
model BusinessHours {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  dayOfWeek   Int      @db.SmallInt // 0 = Sunday, 6 = Saturday
  openingTime String   @map("opening_time") @db.VarChar(5) // "09:00"
  closingTime String   @map("closing_time") @db.VarChar(5) // "22:00"
  isClosed    Boolean  @default(false) @map("is_closed")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  business BusinessProfile @relation(fields: [businessId], references: [userId], onDelete: Cascade)

  @@unique([businessId, dayOfWeek])
  @@index([businessId])
  @@map("business_hours")
}

// Inventory Management
model Inventory {
  id            String    @id @default(uuid()) @db.Uuid
  businessId    String    @map("business_id") @db.Uuid
  itemId        String    @unique @map("item_id") @db.Uuid
  currentStock  Int       @default(0) @map("current_stock")
  minimumStock  Int       @default(0) @map("minimum_stock")
  unit          String    @default("pieces") @db.VarChar(50)
  costPerUnit   Decimal?  @map("cost_per_unit") @db.Decimal(8, 2)
  supplier      String?   @db.VarChar(255)
  supplierId    String?   @map("supplier_id") @db.Uuid
  autoReorder   Boolean   @default(false) @map("auto_reorder")
  lastRestocked DateTime? @map("last_restocked")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  item MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([businessId, currentStock])
  @@map("inventory")
}

// Reviews & Ratings System
model Review {
  id         String  @id @default(uuid()) @db.Uuid
  orderId    String  @unique @map("order_id") @db.Uuid
  customerId String  @map("customer_id") @db.Uuid
  businessId String  @map("business_id") @db.Uuid
  driverId   String? @map("driver_id") @db.Uuid

  // Overall rating (1-5)
  rating Int @db.SmallInt

  // Detailed ratings (1-5 each, optional)
  foodQuality    Int? @map("food_quality") @db.SmallInt
  serviceQuality Int? @map("service_quality") @db.SmallInt
  deliverySpeed  Int? @map("delivery_speed") @db.SmallInt
  valueForMoney  Int? @map("value_for_money") @db.SmallInt

  // Review content
  comment String? @db.Text
  images  Json    @default("[]")

  // Moderation
  isVerified      Boolean @default(false) @map("is_verified")
  isHidden        Boolean @default(false) @map("is_hidden")
  moderationNotes String? @map("moderation_notes") @db.Text

  // Response from business
  businessResponse String?   @map("business_response") @db.Text
  respondedAt      DateTime? @map("responded_at")

  // Helpful votes
  helpfulCount Int @default(0) @map("helpful_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  order    Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer User            @relation("customer_reviews", fields: [customerId], references: [id], onDelete: Cascade)
  business BusinessProfile @relation(fields: [businessId], references: [userId], onDelete: Cascade)
  driver   User?           @relation("driver_reviews", fields: [driverId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([businessId])
  @@index([driverId])
  @@index([rating])
  @@index([createdAt])
  @@index([businessId, rating])
  @@map("reviews")
}

