  businessId      String   @map("business_id") @db.Uuid
  inviteCode      String   @unique @map("invite_code")
  status          String   @default("open") // open, locked, placed, delivered, cancelled
  splitMethod     String   @default("individual") @map("split_method") // individual, equal, custom
  deliveryFee     Float    @default(0) @map("delivery_fee")
  expiresAt       DateTime? @map("expires_at")
  orderId         String?  @unique @map("order_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  host     User             @relation("group_order_host", fields: [hostId], references: [id], onDelete: Cascade)
  business BusinessProfile  @relation("group_order_business", fields: [businessId], references: [userId], onDelete: Cascade)
  order    Order?           @relation("group_order_placed", fields: [orderId], references: [id], onDelete: SetNull)
  members  GroupOrderMember[]

  @@index([hostId])
  @@index([businessId])
  @@index([inviteCode])
  @@map("group_orders")
}

model GroupOrderMember {
  id            String   @id @default(uuid()) @db.Uuid
  groupOrderId  String   @map("group_order_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  status        String   @default("pending") // pending, ordering, ready
  items         Json     @default("[]")
  subtotal      Float    @default(0)
  joinedAt      DateTime @default(now()) @map("joined_at")

  groupOrder GroupOrder @relation(fields: [groupOrderId], references: [id], onDelete: Cascade)
  user       User       @relation("group_order_members", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupOrderId, userId])
  @@index([groupOrderId])
  @@index([userId])
  @@map("group_order_members")
}

