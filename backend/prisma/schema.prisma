  name           String   @db.VarChar(100)
  type           String   @db.VarChar(20)
  monthlyPremium Int      @map("monthly_premium")
  coverage       String[]
  maxCoverage    Int      @map("max_coverage")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([active, type])
  @@map("insurance_plans")
}

model InsuranceClaim {
  id          String   @id @default(uuid()) @db.Uuid
  courierId   String   @map("courier_id") @db.Uuid
  type        String   @db.VarChar(50)
  description String   @db.Text
  amount      Int
  status      String   @default("pending") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at")

  courier User @relation("InsuranceClaims", fields: [courierId], references: [id], onDelete: Cascade)

  @@index([courierId, status])
  @@map("insurance_claims")
}

model MaintenanceLog {
  id        String   @id @default(uuid()) @db.Uuid
  courierId String   @map("courier_id") @db.Uuid
  action    String   @db.VarChar(200)
  cost      Int
  mileage   String?  @db.VarChar(50)
  date      DateTime @db.Date
  createdAt DateTime @default(now()) @map("created_at")

  courier User @relation("MaintenanceLogs", fields: [courierId], references: [id], onDelete: Cascade)

  @@index([courierId, date])
  @@map("maintenance_logs")
}

model TrainingModule {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @db.VarChar(200)
  description String   @db.Text
  icon        String   @db.VarChar(50)
  color       String   @db.VarChar(20)
  duration    String   @db.VarChar(50)
  lessons     Int
  required    Boolean  @default(false)
  category    String   @db.VarChar(50)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  progress CourierTrainingProgress[]

  @@index([category, sortOrder])
  @@map("training_modules")
}

model CourierTrainingProgress {
  id               String   @id @default(uuid()) @db.Uuid
  courierId        String   @map("courier_id") @db.Uuid
  moduleId         String   @map("module_id") @db.Uuid
  completedLessons Int      @default(0) @map("completed_lessons")
  updatedAt        DateTime @updatedAt @map("updated_at")

  courier User           @relation("CourierTrainingProgress", fields: [courierId], references: [id], onDelete: Cascade)
  module  TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([courierId, moduleId])
  @@index([courierId])
  @@map("courier_training_progress")
}

model SurgeZone {
  id              String   @id @default(uuid()) @db.Uuid
  area            String   @db.VarChar(100)
  multiplier      Float
  estimatedOrders Int      @map("estimated_orders")
  level           String   @db.VarChar(20)
  latitude        Float
  longitude       Float
  radius          Float
  expiresAt       DateTime @map("expires_at")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([active, expiresAt])
  @@index([latitude, longitude])
  @@map("surge_zones")
}

model VerificationAttempt {
  id         String   @id @default(uuid()) @db.Uuid
  courierId  String   @map("courier_id") @db.Uuid
  photoUrl   String   @map("photo_url") @db.Text
  verified   Boolean
  confidence Float    @default(0)
  reason     String?  @db.VarChar(50)
  createdAt  DateTime @default(now()) @map("created_at")

  courier User @relation("CourierVerificationAttempts", fields: [courierId], references: [id], onDelete: Cascade)

  @@index([courierId, createdAt])
  @@map("verification_attempts")
}

model NotificationTemplate {
  id           String           @id @default(uuid()) @db.Uuid
  key          String           @unique @db.VarChar(100)
  name         String           @db.VarChar(200)
  description  String?          @db.Text
  title        String           @db.VarChar(200)
  body         String           @db.Text
  type         NotificationType
  category     String           @db.VarChar(50)
  targetRole   String[]
  isScheduled  Boolean          @default(false) @map("is_scheduled")
  scheduleTime String?          @db.VarChar(50) @map("schedule_time")
  isActive     Boolean          @default(true) @map("is_active")
  isDefault    Boolean          @default(false) @map("is_default")
  variant      String?          @db.VarChar(10)
  variantGroup String?          @db.VarChar(100) @map("variant_group")
  sentCount    Int              @default(0) @map("sent_count")
  openCount    Int              @default(0) @map("open_count")
  clickCount   Int              @default(0) @map("click_count")
  createdBy    String?          @map("created_by") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  lastUsedAt   DateTime?        @map("last_used_at")

  creator User? @relation("NotificationTemplateCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([key])
  @@index([type])
  @@index([category])
  @@index([isActive])
  @@index([variantGroup])
  @@map("notification_templates")
}

model NotificationLog {
  id           String    @id @default(uuid()) @db.Uuid
  templateId   String?   @map("template_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  title        String    @db.VarChar(200)
  body         String    @db.Text
  data         Json?
  status       String    @db.VarChar(50)
  platform     String    @db.VarChar(20)
  sentAt       DateTime  @default(now()) @map("sent_at")
  deliveredAt  DateTime? @map("delivered_at")
  openedAt     DateTime? @map("opened_at")
  clickedAt    DateTime? @map("clicked_at")
  errorMessage String?   @map("error_message") @db.Text

  user User @relation("UserNotificationLogs", fields: [userId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@index([userId])
  @@index([status])
  @@index([sentAt])
  @@map("notification_logs")
}
