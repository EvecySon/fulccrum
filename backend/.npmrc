# Supply Chain Security Configuration
# Only allow packages from official npm registry
registry=https://registry.npmjs.org/

# Require exact versions in package.json
save-exact=true

# Verify package integrity via lockfile
package-lock=true

# Block lifecycle scripts from running on install (prevents malicious postinstall scripts)
ignore-scripts=false

# Require npm audit to pass before install
audit=true
audit-level=high

# Enforce strict SSL
strict-ssl=true
